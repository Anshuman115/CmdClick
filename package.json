{
  "name": "cmd-click",
  "displayName": "Cmd-Click",
  "description": "MoleculerJS code navigation — Cmd+Click on service action strings and reference counts",
  "version": "0.2.0",
  "publisher": "Anshuman115",
  "license": "Apache-2.0",
  "author": "Anshuman Tripathy",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anshuman115/CmdClick"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "moleculer",
    "moleculerjs",
    "microservices",
    "code-navigation",
    "go-to-definition",
    "cmdclick",
    "cmd-click"
  ],
  "activationEvents": [
    "onLanguage:javascript"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "CmdClick",
      "properties": {
        "cmdclick.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable CmdClick language server"
        }
      }
    },
    "commands": [
      {
        "command": "cmdclick.showReferences",
        "title": "CmdClick: Show References"
      },
      {
        "command": "cmdclick.clearBreadcrumbs",
        "title": "CmdClick: Clear Navigation Breadcrumbs"
      }
    ],
    "configurationDefaults": {
      "editor.gotoLocation.multipleDefinitions": "goto"
    }
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "chokidar": "^5.0.0",
    "mnemonist": "^0.40.4",
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vscode/vsce": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run src",
    "dev": "tsx src/main.ts",
    "package": "npm run build && vsce package --allow-missing-repository"
  }
}